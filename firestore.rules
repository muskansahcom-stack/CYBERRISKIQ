rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user belongs to the requested organization
    function isOrgMember(orgId) {
      return isAuthenticated() && 
        request.auth.token.organization_id == orgId;
    }

    // Default match rules
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'Organization Administrator';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'Organization Administrator');
    }

    match /cyber_assets/{assetId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /vulnerabilities/{vulnId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /security_controls/{controlId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log rule
    }
  }
}
